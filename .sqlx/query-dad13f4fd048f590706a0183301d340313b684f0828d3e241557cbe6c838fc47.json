{
  "db_name": "PostgreSQL",
  "query": "\n        select i.id, i.kind, i.title, i.document, i.tabled_on, i.status, s.url as source_url\n        from initiatives i\n        join initiative_parties ip on ip.initiative_id = i.id\n        join sources s on s.id = i.source_id\n        where ip.party_id = $1\n        order by i.tabled_on desc, i.id desc\n        limit $2 offset $3\n        ",
