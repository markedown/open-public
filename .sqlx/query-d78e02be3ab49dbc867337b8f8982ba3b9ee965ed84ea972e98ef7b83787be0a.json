  "query": "\n        select id, place, part, postal_code, district, region\n        from constituency_places\n        where country_id = $1\n          and (postal_code = $2\n               or unaccent(lower(place)) like unaccent(lower($2)) || '%')\n        order by place, part nulls first, district\n        limit 30\n        ",
