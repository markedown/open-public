  "query": "\n        select gp.group_vote_id, gp.side, p.slug as party_slug, p.short_name, p.color\n        from group_vote_parties gp\n        join parties p on p.id = gp.party_id\n        where gp.group_vote_id = any($1)\n        order by p.short_name\n        ",
