  "query": "\n        select o.id, o.label, o.position, o.media_url, count(bo.ballot_id) as \"votes!\"\n        from poll_options o\n        left join ballot_options bo on bo.option_id = o.id\n        where o.poll_id = $1\n        group by o.id\n        order by o.position\n        ",
